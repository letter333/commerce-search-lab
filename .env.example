# Optional local environment file. The supplied Compose configuration needs no values here.
# The real Elasticsearch password belongs only in:
# .local/elasticsearch/elastic-password.txt
# Compose injects that file through the elastic_password secret.

# Optional Java Client settings. Supply through the IntelliJ run configuration
# or the current process environment; Spring/Gradle do not auto-load this file.
# See docs/java-client-setup.md. These are empty placeholders, not credentials.
ES_ENABLED=
ES_URL=
ES_USERNAME=
ES_PASSWORD_FILE=
ES_CA_CERT=
ES_CONNECT_TIMEOUT=
ES_REQUEST_TIMEOUT=
